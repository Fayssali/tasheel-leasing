# Production values for docker-compose.example.yml. Copy to .env.production (never commit it;
# better: inject from a secret store). Every empty value must be filled in.
# Passwords and secrets: openssl rand -hex 32   (hex: safe inside database URLs)
# MFA_ENCRYPTION_KEY only:  openssl rand -base64 32
# Do not put comments at the end of a line: they would become part of the value.

TASHEEL_DOMAIN=app.example.dz
# Image tag to run, e.g. the git commit SHA.
TASHEEL_VERSION=
REGISTRY=tasheel

POSTGRES_SUPERUSER_PASSWORD=
# Owns the schema and runs migrations.
TASHEEL_ADMIN_PASSWORD=
# Used by the API, subject to Row-Level Security.
TASHEEL_APP_PASSWORD=

# At least 32 random characters.
JWT_ACCESS_SECRET=
# Exactly 32 random bytes, base64. Losing it disables every user's two-step verification.
MFA_ENCRYPTION_KEY=

MINIO_ROOT_USER=tasheel
MINIO_ROOT_PASSWORD=
S3_REGION=dz-1

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tasheel Leasing <no-reply@example.dz>"
