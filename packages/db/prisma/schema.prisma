// Tasheel Leasing — database schema
// Phase 1 scope: M0 Foundation (identity, organizations, roles, permissions, audit).
// Business modules (M1–M9) are added in later migrations, phase by phase.
//
// Conventions (see docs/adr/0002-multi-tenancy.md and the Phase 0 specification, section 4.1):
// - UUID v7 primary keys, generated by Prisma.
// - Every tenant-owned table carries organization_id and is protected by Row-Level Security.
// - snake_case in the database, camelCase in TypeScript.
// - Soft delete (deleted_at) on business records; audit_logs is append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_ADMIN")
}

enum OrganizationType {
  PLATFORM
  SUPPLIER
  FINANCIAL_INSTITUTION
  BUSINESS
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  REJECTED
}

enum MemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum Locale {
  fr
  ar
  en
}

model Organization {
  id                String             @id @default(uuid(7)) @db.Uuid
  type              OrganizationType
  status            OrganizationStatus @default(PENDING_VERIFICATION)
  statusReason      String?            @map("status_reason")
  legalName         String             @map("legal_name")
  tradeName         String?            @map("trade_name")
  // Algerian legal identifiers (format validation lives in @tasheel/shared)
  rcNumber          String?            @map("rc_number") // Registre du commerce
  nif               String?            // Numéro d'identification fiscale
  nis               String?            // Numéro d'identification statistique
  articleImposition String?            @map("article_imposition")
  wilayaCode        String?            @map("wilaya_code") @db.VarChar(2)
  address           String?
  email             String?
  phone             String?
  defaultLocale     Locale             @default(fr) @map("default_locale")
  verifiedAt        DateTime?          @map("verified_at")
  verifiedById      String?            @map("verified_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")

  members     OrganizationMember[]
  roles       Role[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  listings    EquipmentListing[]

  @@index([type, status])
  @@map("organizations")
}

// Users are global: one person can belong to several organizations.
model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  passwordHash     String    @map("password_hash") // Argon2id
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  locale           Locale    @default(fr)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret") // AES-256-GCM sealed (apps/api/src/auth/mfa/secret-box.ts)
  mfaPendingSecret String?   @map("mfa_pending_secret") // sealed; set during enrolment until confirmed
  mfaRecoveryCodes String[]  @default([]) @map("mfa_recovery_codes") // SHA-256 hashes, removed when used
  mfaLastUsedStep  Int?      @map("mfa_last_used_step") // last accepted TOTP step (replay protection)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  memberships OrganizationMember[]
  sessions    Session[]
  tokens      UserToken[]

  @@map("users")
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Single-use tokens sent by email. Only the SHA-256 of the secret is stored.
// Visible only to their owner (RLS on user_id).
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_tokens")
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MemberRole[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("organization_members")
}

// System roles have organization_id = NULL and apply to every organization of `organizationType`.
// Custom roles belong to one organization.
model Role {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String?           @map("organization_id") @db.Uuid
  organizationType OrganizationType  @map("organization_type")
  code             String
  name             Json // { "fr": "...", "ar": "...", "en": "..." }
  isSystem         Boolean           @default(false) @map("is_system")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  members      MemberRole[]
  invitations  Invitation[]

  @@unique([organizationId, code])
  @@index([organizationType, isSystem])
  @@map("roles")
}

// Permission catalogue, seeded from @tasheel/shared. Global, read-only for the app.
model Permission {
  code             String             @id // e.g. "application.review"
  description      String
  allowedOrgTypes  OrganizationType[] @map("allowed_org_types")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String  @map("role_id") @db.Uuid
  permissionCode String  @map("permission_code")
  organizationId String? @map("organization_id") @db.Uuid // copied from role, for RLS

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model MemberRole {
  memberId       String @map("member_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid // copied from member, for RLS

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([memberId, roleId])
  @@index([organizationId])
  @@map("member_roles")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@map("invitations")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

// Append-only: the app role has INSERT and SELECT only (enforced in migration SQL).
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String // e.g. "organization.verified", "application.status_changed"
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  diff           Json? // before/after, sensitive fields masked
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// Phase 2 — Marketplace (M1)
// =============================================================================

enum EquipmentCondition {
  NEW
  USED
  REFURBISHED
}

enum EquipmentAvailability {
  IN_STOCK
  ON_ORDER
  UNAVAILABLE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum EquipmentDocumentKind {
  BROCHURE
  SPEC_SHEET
  OTHER
}

enum QuotationRequestStatus {
  OPEN
  QUOTED
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

// Global reference data, edited by Tasheel. specSchema lists the technical fields of the
// category: [{ key, label: {fr,ar,en}, type: "number"|"text"|"select", unit?, options? }].
model EquipmentCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  code       String   @unique
  name       Json // { "fr": "...", "ar": "...", "en": "..." }
  specSchema Json     @default("[]") @map("spec_schema")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  parent   EquipmentCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children EquipmentCategory[] @relation("CategoryTree")
  listings EquipmentListing[]

  @@index([parentId, sortOrder])
  @@map("equipment_categories")
}

model EquipmentListing {
  id                String                @id @default(uuid(7)) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid // supplier
  reference         String                @unique // EQ-YYYY-NNNNNN
  categoryId        String                @map("category_id") @db.Uuid
  title             Json // { fr?, ar? } at least one
  description       Json                  @default("{}")
  brand             String?
  model             String?
  year              Int?
  condition         EquipmentCondition    @default(NEW)
  price             Decimal?              @db.Decimal(18, 2)
  currency          String                @default("DZD") @db.Char(3)
  priceOnRequest    Boolean               @default(false) @map("price_on_request")
  priceIncludesVat  Boolean               @default(false) @map("price_includes_vat")
  availability      EquipmentAvailability @default(IN_STOCK)
  leadTimeDays      Int?                  @map("lead_time_days")
  deliveryWilayas   String[]              @default([]) @map("delivery_wilayas") // empty = nationwide
  warrantyMonths    Int?                  @map("warranty_months")
  specs             Json                  @default("{}")
  status            ListingStatus         @default(DRAFT)
  statusReason      String?               @map("status_reason")
  publishedAt       DateTime?             @map("published_at")
  viewCount         Int                   @default(0) @map("view_count")
  searchVector      Unsupported("tsvector")? @map("search_vector") // maintained by trigger
  createdById       String                @map("created_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  deletedAt         DateTime?             @map("deleted_at")

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category          EquipmentCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            EquipmentImage[]
  documents         EquipmentDocument[]
  favourites        Favourite[]
  quotationRequests QuotationRequest[]
  quotations        Quotation[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([status, categoryId, price])
  @@map("equipment_listings")
}

model EquipmentImage {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  storageKey     String   @unique @map("storage_key")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  listing EquipmentListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId, sortOrder])
  @@map("equipment_images")
}

model EquipmentDocument {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  listingId      String                @map("listing_id") @db.Uuid
  kind           EquipmentDocumentKind @default(BROCHURE)
  fileName       String                @map("file_name")
  storageKey     String                @unique @map("storage_key")
  mimeType       String                @map("mime_type")
  sizeBytes      Int                   @map("size_bytes")
  createdAt      DateTime              @default(now()) @map("created_at")

  listing EquipmentListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@map("equipment_documents")
}

model Favourite {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  listing EquipmentListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([userId, listingId])
  @@index([organizationId])
  @@map("favourites")
}

// Owned by the requesting business; shared with the supplier through supplier_org_id.
model QuotationRequest {
  id              String                 @id @default(uuid(7)) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid // business
  supplierOrgId   String                 @map("supplier_org_id") @db.Uuid
  reference       String                 @unique // QR-YYYY-NNNNNN
  listingId       String                 @map("listing_id") @db.Uuid
  requestedById   String                 @map("requested_by_id") @db.Uuid
  quantity        Int                    @default(1)
  message         String?
  deliveryWilaya  String?                @map("delivery_wilaya") @db.VarChar(2)
  status          QuotationRequestStatus @default(OPEN)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  listing    EquipmentListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  quotations Quotation[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([supplierOrgId, status, createdAt(sort: Desc)])
  @@map("quotation_requests")
}

// Owned by the issuing supplier; shared with the business through business_org_id.
// lines: [{ label, quantity, unitPrice }] as decimal strings. Totals are stored as computed
// at issue time; vatRate is entered by the supplier (no hardcoded tax rate).
model Quotation {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid // supplier
  businessOrgId   String          @map("business_org_id") @db.Uuid
  requestId       String          @map("request_id") @db.Uuid
  listingId       String          @map("listing_id") @db.Uuid
  reference       String          @unique // QT-YYYY-NNNNNN
  issuedById      String          @map("issued_by_id") @db.Uuid
  currency        String          @default("DZD") @db.Char(3)
  lines           Json
  subtotal        Decimal         @db.Decimal(18, 2)
  vatRate         Decimal         @default(0) @map("vat_rate") @db.Decimal(7, 4)
  vatAmount       Decimal         @map("vat_amount") @db.Decimal(18, 2)
  total           Decimal         @db.Decimal(18, 2)
  validUntil      DateTime        @map("valid_until") @db.Date
  deliveryTerms   String?         @map("delivery_terms")
  notes           String?
  status          QuotationStatus @default(ISSUED)
  decidedAt       DateTime?       @map("decided_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  request QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  listing EquipmentListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([businessOrgId, status, createdAt(sort: Desc)])
  @@map("quotations")
}

// Platform-wide settings edited from the admin console, e.g. "marketplace.moderation".
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
