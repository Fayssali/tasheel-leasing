// Tasheel Leasing — database schema
// Phase 1 scope: M0 Foundation (identity, organizations, roles, permissions, audit).
// Business modules (M1–M9) are added in later migrations, phase by phase.
//
// Conventions (see docs/adr/0002-multi-tenancy.md and the Phase 0 specification, section 4.1):
// - UUID v7 primary keys, generated by Prisma.
// - Every tenant-owned table carries organization_id and is protected by Row-Level Security.
// - snake_case in the database, camelCase in TypeScript.
// - Soft delete (deleted_at) on business records; audit_logs is append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_ADMIN")
}

enum OrganizationType {
  PLATFORM
  SUPPLIER
  FINANCIAL_INSTITUTION
  BUSINESS
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  REJECTED
}

enum MemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum Locale {
  fr
  ar
  en
}

model Organization {
  id                String             @id @default(uuid(7)) @db.Uuid
  type              OrganizationType
  status            OrganizationStatus @default(PENDING_VERIFICATION)
  statusReason      String?            @map("status_reason")
  legalName         String             @map("legal_name")
  tradeName         String?            @map("trade_name")
  // Algerian legal identifiers (format validation lives in @tasheel/shared)
  rcNumber          String?            @map("rc_number") // Registre du commerce
  nif               String?            // Numéro d'identification fiscale
  nis               String?            // Numéro d'identification statistique
  articleImposition String?            @map("article_imposition")
  wilayaCode        String?            @map("wilaya_code") @db.VarChar(2)
  address           String?
  email             String?
  phone             String?
  defaultLocale     Locale             @default(fr) @map("default_locale")
  verifiedAt        DateTime?          @map("verified_at")
  verifiedById      String?            @map("verified_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")

  members     OrganizationMember[]
  roles       Role[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@index([type, status])
  @@map("organizations")
}

// Users are global: one person can belong to several organizations.
model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  passwordHash     String    @map("password_hash") // Argon2id
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  locale           Locale    @default(fr)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret") // AES-256-GCM sealed (apps/api/src/auth/mfa/secret-box.ts)
  mfaPendingSecret String?   @map("mfa_pending_secret") // sealed; set during enrolment until confirmed
  mfaRecoveryCodes String[]  @default([]) @map("mfa_recovery_codes") // SHA-256 hashes, removed when used
  mfaLastUsedStep  Int?      @map("mfa_last_used_step") // last accepted TOTP step (replay protection)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  memberships OrganizationMember[]
  sessions    Session[]
  tokens      UserToken[]

  @@map("users")
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Single-use tokens sent by email. Only the SHA-256 of the secret is stored.
// Visible only to their owner (RLS on user_id).
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_tokens")
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MemberRole[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("organization_members")
}

// System roles have organization_id = NULL and apply to every organization of `organizationType`.
// Custom roles belong to one organization.
model Role {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String?           @map("organization_id") @db.Uuid
  organizationType OrganizationType  @map("organization_type")
  code             String
  name             Json // { "fr": "...", "ar": "...", "en": "..." }
  isSystem         Boolean           @default(false) @map("is_system")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  members      MemberRole[]
  invitations  Invitation[]

  @@unique([organizationId, code])
  @@index([organizationType, isSystem])
  @@map("roles")
}

// Permission catalogue, seeded from @tasheel/shared. Global, read-only for the app.
model Permission {
  code             String             @id // e.g. "application.review"
  description      String
  allowedOrgTypes  OrganizationType[] @map("allowed_org_types")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String  @map("role_id") @db.Uuid
  permissionCode String  @map("permission_code")
  organizationId String? @map("organization_id") @db.Uuid // copied from role, for RLS

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model MemberRole {
  memberId       String @map("member_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid // copied from member, for RLS

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([memberId, roleId])
  @@index([organizationId])
  @@map("member_roles")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@map("invitations")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

// Append-only: the app role has INSERT and SELECT only (enforced in migration SQL).
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String // e.g. "organization.verified", "application.status_changed"
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  diff           Json? // before/after, sensitive fields masked
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
