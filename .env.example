# Copy to .env and adjust. Never commit real secrets.

# --- Database ---
# Migration / admin role (owns the schema, bypasses RLS). Used only by Prisma migrate and seed.
DATABASE_URL_ADMIN=postgresql://tasheel_admin:tasheel_admin_dev@localhost:5432/tasheel
# Application role (subject to Row-Level Security). Used by the API at runtime.
DATABASE_URL=postgresql://tasheel_app:tasheel_app_dev@localhost:5432/tasheel

# --- Redis (queues, cache, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible, MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=dz-local
S3_BUCKET_DOCUMENTS=tasheel-documents
S3_ACCESS_KEY=tasheel
S3_SECRET_KEY=tasheel_minio_dev

# --- Email (Mailpit locally: UI on http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Tasheel Leasing <no-reply@tasheel.local>"

# --- API ---
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- Web ---
VITE_API_URL=/api/v1

# Base URL of the web app, used in links sent by email (verification, password reset)
WEB_APP_URL=http://localhost:5173

# 32 random bytes, base64. Encrypts TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Development value only — production uses a key from the secret store.
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS1jaGFuZ2UtbWUtMzJieXQ=
